# Local-dev env for the gateway (run with: node --env-file=server/.env server/index.js)
# In production these live in Fly secrets (`fly secrets set ...`), NEVER in the repo.
# Every Discord var is optional — each feature turns on when its secret is set.

PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# session cookie signing key: openssl rand -hex 32
SESSION_SECRET=

# Discord Developer Portal → your application (see docs/DEPLOY.md §3)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_URL=
